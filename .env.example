# Copia este archivo a ".env" para fijar la configuración, o exporta las
# variables en tu shell. app/core/config.py las lee con estos valores por
# defecto.

# Tamaños whisper: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# auto (usa CUDA si hay GPU) | cpu | cuda
WHISPER_DEVICE=auto

# auto | int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto

# Número de beams en la búsqueda (5 = buen equilibrio)
WHISPER_BEAM_SIZE=5

# Código Argos del idioma de salida al pulsar "Traducir" (es = español)
TRANSLATE_TARGET_LANG=es

# Segmentación de frases para Argos: MINISBD evita stanza en runtime.
# (No cambies esto a menos que instales stanza completo a propósito.)
ARGOS_CHUNK_TYPE=MINISBD